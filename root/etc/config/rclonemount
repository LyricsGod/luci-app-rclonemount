config rclonemount 'main'
	option enabled '1'
	option remote 'alist:'
	option mountpoint '/mnt/nvme0n1p5/Alist'
	option rclone_config '/root/.config/rclone/rclone.conf'
	option cachedir '/mnt/nvme0n1p5/Caches/Rclone'
	option logfile '/mnt/nvme0n1p5/Logs/rclone-alist.log'
	option alist_url 'http://127.0.0.1:5244'

config webdav 'webdav'
	option sync '1'
	option url 'http://127.0.0.1:5244/dav'
	option vendor 'other'
	option user 'liuyu'
	option pass ''

config cache 'cache'
	option max_size '20G'
	option min_free '5G'
	option max_age '72h'
	option read_ahead '128M'
	option buffer_size '32M'
	option chunk_size '32M'
	option chunk_limit '128M'
	option dir_cache_time '72h'
	option attr_timeout '1h'

config network 'network'
	option transfers '4'
	option checkers '8'
	option tpslimit '8'
	option tpslimit_burst '16'
	option timeout '5m'
	option retries '3'
	option retries_sleep '3s'
	option low_level_retries '10'
	option log_level 'INFO'

config mountopts 'mountopts'
	option read_only '1'
	option allow_other '1'
	option allow_non_empty '1'
	option use_mmap '1'
	option no_referer '1'

config jellyfin 'jellyfin'
	option enabled '1'
	option container 'jellyfin'
	option restart_after_mount '1'
